# dday-flower Docker 운영용 환경변수 예시
# 사용: cp .env.docker.example .env 후 값 채우기 (또는 기존 .env 에 아래 키 병합)

APP_NAME="꽃배달 쇼핑몰"
APP_ENV=production
APP_DEBUG=false
# 실제 도메인으로 교체 (결제 콜백·SEO·메일 링크 기준)
APP_URL=https://rustkorea.cloud
APP_KEY=
# 비어 있으면 컨테이너 첫 기동 시 생성 후 .env 에 저장됨

# ---- DB (compose db 서비스와 일치시킬 것) ----
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=g7
DB_USERNAME=g7
DB_PASSWORD=여기에_긴_비밀번호
DB_PREFIX=g7_
# compose db 서비스 기동용 (위와 동일 값)
DB_ROOT_PASSWORD=여기에_root_비밀번호

# ---- 캐시·세션·큐 (compose redis 사용 권장) ----
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
# predis 동봉이라 PHP 확장은 불필요
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ---- 메일 (주문·알림 발송용, 필수 설정) ----
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@rustkorea.cloud"
MAIL_FROM_NAME="꽃배달 쇼핑몰"

# ---- 부팅 동작 ----
RUN_MIGRATIONS=true
RUN_EXTENSION_UPDATE=true

# ---- 웹 포트 (호스트 바인딩, CloudPanel 프록시 사용 시 127.0.0.1:8080 권장) ----
WEB_PORT=80
