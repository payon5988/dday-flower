{
    "version": "1.0.0",
    "layout_name": "home",
    "permissions": [],
    "extends": "_user_base",
    "meta": {
        "seo": {
            "enabled": true,
            "data_sources": [
                "products",
                "dayStatus",
                "flowerFaqs"
            ],
            "priority": 1.0,
            "changefreq": "daily",
            "og": {
                "type": "website",
                "title": "$t:shop.flower.home_title"
            },
            "structured_data": {
                "@type": "WebSite",
                "name": "{{_global.site_name ?? ''}}",
                "url": "{{_global.site_url ?? ''}}"
            }
        }
    },
    "data_sources": [
        {
            "id": "products",
            "label_key": "$t:editor.data_source.products",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/products",
            "method": "GET",
            "auth_mode": "optional",
            "params": {
                "page": 1,
                "per_page": 4,
                "sort": "latest"
            },
            "auto_fetch": true,
            "loading_strategy": "progressive",
            "fallback": {
                "data": []
            }
        },
        {
            "id": "dayStatus",
            "label_key": "$t:editor.data_source.dayStatus",
            "type": "api",
            "endpoint": "/api/plugins/sirsoft-flower_delivery/delivery-day-status",
            "method": "GET",
            "auth_mode": "optional",
            "params": {
                "product_id": 1
            },
            "auto_fetch": true,
            "loading_strategy": "progressive",
            "fallback": {
                "date": "",
                "cutoff": "14:00",
                "is_today": true,
                "same_day_available": false,
                "same_day_remaining": 0
            }
        },
        {
            "id": "flowerFaqs",
            "label_key": "$t:editor.data_source.flowerFaqs",
            "type": "api",
            "endpoint": "/api/plugins/sirsoft-flower_delivery/faqs",
            "method": "GET",
            "auth_mode": "optional",
            "auto_fetch": true,
            "loading_strategy": "progressive",
            "fallback": {
                "faqs": []
            }
        }
    ],
    "slots": {
        "content": [
            {
                "comment": "꽃배달 공지 바",
                "partial": "partials/shop/flower/_notice.json"
            },
            {
                "comment": "꽃배달 히어로",
                "partial": "partials/shop/flower/_hero.json"
            },
            {
                "comment": "꽃배달 Today's Pick",
                "partial": "partials/shop/flower/_pick.json"
            },
            {
                "comment": "꽃배달 상황별 큐레이션",
                "partial": "partials/shop/flower/_occasion.json"
            },
            {
                "comment": "꽃배달 배송 안내",
                "partial": "partials/shop/flower/_guide.json"
            },
            {
                "comment": "꽃배달 구독 CTA",
                "partial": "partials/shop/flower/_sub_cta.json"
            },
            {
                "comment": "꽃배달 브랜드 스토리",
                "partial": "partials/shop/flower/_story.json"
            },
            {
                "comment": "꽃배달 FAQ",
                "partial": "partials/shop/flower/_faq.json"
            },
            {
                "comment": "꽃말 사전",
                "partial": "partials/shop/flower/_dict.json"
            },
            {
                "comment": "기업 대량주문 안내",
                "partial": "partials/shop/flower/_b2b.json"
            },
            {
                "comment": "꽃 관리 팁",
                "partial": "partials/shop/flower/_tips.json"
            }
        ]
    }
}
